#!/usr/bin/env bash
set -euo pipefail

repo_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$repo_dir"

PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s tests -v
PYTHONDONTWRITEBYTECODE=1 python3 -m py_compile anker_c200_backend.py obs_control.py runtime_guard.py secure_io.py
build_root=$(mktemp -d /tmp/anker-c200-controller.XXXXXX)
cleanup_build() {
  find "$build_root" -depth -mindepth 1 -delete
  rmdir "$build_root"
}
trap cleanup_build EXIT
cc -O2 -Wall -Wextra -Werror -std=c11 \
  -Ivendor/anker-powerconf-c200-linux-tools/src \
  vendor/anker-powerconf-c200-linux-tools/src/c200_fov.c \
  vendor/anker-powerconf-c200-linux-tools/src/c200_vendor.c \
  vendor/anker-powerconf-c200-linux-tools/src/c200_controls.c \
  vendor/anker-powerconf-c200-linux-tools/src/c200_fov_cli.c \
  -o "$build_root/anker-c200"
"$build_root/anker-c200" list-controls >/dev/null
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$repo_dir"
fi

qml_lint=""
if command -v qmllint >/dev/null 2>&1; then
  qml_lint=$(command -v qmllint)
elif [[ -x /usr/lib/qt6/bin/qmllint ]]; then
  qml_lint=/usr/lib/qt6/bin/qmllint
fi
if [[ -n "$qml_lint" && -d "${OMARCHY_PATH:-/usr/share/omarchy}/shell" ]]; then
  lint_root=$(mktemp -d /tmp/anker-c200-qml.XXXXXX)
  cleanup_lint() {
    find "$lint_root" -depth -mindepth 1 -delete
    rmdir "$lint_root"
  }
  trap 'cleanup_lint; cleanup_build' EXIT
  ln -s "${OMARCHY_PATH:-/usr/share/omarchy}/shell" "$lint_root/qs"
  "$qml_lint" -I "$lint_root" Panel.qml BoundedProcess.qml >/dev/null 2>&1
  cleanup_lint
  trap cleanup_build EXIT
fi
git diff --check
